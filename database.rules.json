{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "roomPrivate": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "presence": {
      "$roomId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "locations": {
      ".read": "auth != null"
    }
  }
}