{
  "rules": {
    "locations": {
      ".indexOn": ["active"],
      ".read": "auth != null",
      "$locationId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins/' + auth.uid).exists()"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",

        ".write": false

        // หมายเหตุสำคัญ: ห้ามใส่ child rule กันข้อมูลลับใต้โหนดนี้ (เช่น location/role/isSpy)
        // เพราะ security rules cascade — rule ที่ parent อนุญาตแล้ว child กันไม่ได้
        // (child rule ห้าม "revoke" สิทธิ์ที่ parent ให้ไว้) ข้อมูลลับต้องย้ายออกไป
        // อยู่ที่ roomPrivate/{roomId}/{uid} ซึ่งเปิดอ่านได้เฉพาะเจ้าของ uid
      }
    },

    "roomPrivate": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": false
        }
      }
    },

    "presence": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": "auth != null && $uid === auth.uid"
        }
      }
    }
  }
}
