{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'online', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "lastOfflineAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "roomPrivate": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "presence": {
      "$roomId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": false
      }
    },
    "locations": {
      ".read": "auth != null"
    }
  }
}
