{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "tasks": {
      "port": 9499
    },
    "ui": {
      "enabled": true
    },
     "database": { "port": 9000 },
    "singleProjectMode": true
  },
  "database": {
    "rules": "database.rules.json"
  }
}
